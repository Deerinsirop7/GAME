; Pixel Pet — уютный тамагочи. Проект Godot 4.3+

config_version=5

[application]

config/name="Pixel Pet: Уютный домик"
config/description="Пиксельный тамагочи: уход за питомцем и обустройство домика."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.99, 0.95, 0.88, 1)
boot_splash/show_image=false

[autoload]

Catalog="*res://scripts/autoload/catalog.gd"
Art="*res://scripts/autoload/art.gd"
UIKit="*res://scripts/ui/ui_kit.gd"
GameState="*res://scripts/autoload/game_state.gd"
TimeWeather="*res://scripts/autoload/time_weather.gd"
Audio="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.35, 0.55, 0.8, 1)
